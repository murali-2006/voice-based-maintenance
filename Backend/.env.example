# Backend Environment Variables (Render / Cloud Hosting)

# Port assigned by hosting provider (defaults to 5000 locally)
PORT=5000

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Credentials
# Option 1: Full JSON string of serviceAccountKey.json (Recommended on Render)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option 2: Individual variables
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_CLIENT_EMAIL=your_firebase_client_email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# URL of deployed Whisper ML Service (default: http://localhost:8000)
ML_SERVICE_URL=http://localhost:8000

# URL of deployed Frontend (for CORS security, e.g., https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173
